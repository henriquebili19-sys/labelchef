# Copie para ".env" na raiz do projeto antes de rodar o docker compose de produção.
# docker compose lê automaticamente o arquivo ".env" na raiz.

BASE_DOMAIN=labelchef.com.br
POSTGRES_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=troque-por-uma-string-aleatoria-longa

# Super admin (dono do sistema), criado no primeiro start se ainda não existir. Senha com 10+ caracteres.
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Sem isso, os alertas de vencimento usam uma conta de teste que não entrega e-mails de verdade.
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario
SMTP_PASS=senha
SMTP_FROM="LabelChef <alertas@labelchef.com.br>"
